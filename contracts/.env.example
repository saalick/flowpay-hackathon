# Deployer (needs Fuji AVAX from https://faucet.avax.network/)
DEPLOYER_PRIVATE_KEY=0x...

# Quote signer (server EOA that signs EIP-712 Quotes)
QUOTE_SIGNER_ADDRESS=0x...

# Server EOA that holds ORCHESTRATOR_ROLE + CONFIRMER_ROLE
ORCHESTRATOR_ADDRESS=0x...

# Snowtrace / Routescan API key for verification
SNOWTRACE_API_KEY=

# Circle Fuji USDC — verify against Circle docs before deploy.
USDC_FUJI=0x5425890298aed601595a70AB815c96711a31Bc65

# Settlement config
P2P_WINDOW_SECONDS=10
LP_PAY_WINDOW_SECONDS=120
PROTOCOL_FEE_BPS=50
TREASURY_ADDRESS=0x...
